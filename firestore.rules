rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function approved() {
   return request.auth != null
    && get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data.enabled == true;
  }
  function owner(uid) { return request.auth != null && request.auth.uid == uid && approved(); }
  function dateString(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
  function monthString(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}$'); }
  function money(v) { return v is int && v >= 0 && v <= 1000000000000; }
  function named(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 100; }
  function account(uid,control,id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(control)/accounts/$(id)); }
  function card(uid,control,id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(control)/cards/$(id)); }
  function category(uid,control,id) { return id is string && id.size() > 0 && exists(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(control)/categories/$(id)); }
  function validAccount(d) { return d.keys().hasAll(['name','kind','openingCents','openingDate']) && d.keys().hasOnly(['name','kind','openingCents','openingDate']) && named(d) && d.kind in ['checking','cash','saving','investment'] && d.openingCents is int && d.openingCents >= -1000000000000 && d.openingCents <= 1000000000000 && dateString(d.openingDate); }
  function validCard(d) { return d.keys().hasAll(['name','closingDay','dueDay','limitCents']) && d.keys().hasOnly(['name','closingDay','dueDay','limitCents']) && named(d) && d.closingDay is int && d.closingDay >= 1 && d.closingDay <= 31 && d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31 && money(d.limitCents); }
  function validBudget(uid,control,d) { return d.keys().hasAll(['month','category','limitCents']) && d.keys().hasOnly(['month','category','limitCents']) && monthString(d.month) && category(uid,control,d.category) && money(d.limitCents) && d.limitCents > 0; }
  function validGoal(d) { return d.keys().hasAll(['name','targetCents','savedCents','deadline']) && d.keys().hasOnly(['name','targetCents','savedCents','deadline']) && named(d) && money(d.targetCents) && d.targetCents > 0 && money(d.savedCents) && dateString(d.deadline); }
  function validTransaction(uid,control,d,id) {
   return d.keys().hasAll(['kind','description','amountCents','category','accountId','toAccountId','cardId','date','dueDate','competence','paidDate','status','groupId','installment','installments'])
    && d.keys().hasOnly(['kind','description','amountCents','category','accountId','toAccountId','cardId','date','dueDate','competence','paidDate','status','groupId','installment','installments','potId','settlementAnchor'])
    && (d.get('settlementAnchor','') == '' || (d.settlementAnchor is string && d.settlementAnchor.size() <= 150 && getAfter(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(control)/settlements/$(d.settlementAnchor)).data.transactionId == id))
    && d.kind in ['income','expense','card','invoicePayment','transfer','yield']
    && d.status in ['planned','posted','cancelled'] && d.description is string && d.description.size() > 0 && d.description.size() <= 200
    && money(d.amountCents) && d.amountCents > 0 && dateString(d.date) && dateString(d.dueDate) && monthString(d.competence)
    && d.category is string && d.accountId is string && d.toAccountId is string && d.cardId is string
    && d.groupId is string && d.groupId.size() <= 100
    && d.installment is int && d.installments is int && d.installment >= 1 && d.installment <= d.installments && d.installments <= 120
    && ((d.status == 'posted' && d.kind != 'card' && dateString(d.paidDate)) || ((d.status != 'posted' || d.kind == 'card') && d.paidDate is string && (d.paidDate == '' || dateString(d.paidDate))))
    && ((d.kind == 'card' && d.accountId == '') || (d.kind != 'card' && account(uid,control,d.accountId)))
    && ((d.kind == 'transfer' && account(uid,control,d.toAccountId) && d.accountId != d.toAccountId) || (d.kind != 'transfer' && d.toAccountId == ''))
    && ((d.kind in ['card','invoicePayment'] && card(uid,control,d.cardId) && d.status != 'planned') || (!(d.kind in ['card','invoicePayment']) && d.cardId == ''))
    && (d.get('potId','') == '' || (d.kind in ['expense','invoicePayment'] && d.potId is string && exists(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(control)/pots/$(d.potId)) && get(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(control)/pots/$(d.potId)).data.accountId == d.accountId))
    && ((d.kind in ['income','expense','card','yield'] && category(uid,control,d.category)) || (d.kind in ['invoicePayment','transfer'] && d.category == ''));
  }
  // Only Firebase console / trusted administration may change approvals.
  match /authorized_users/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, create, update, delete: if false;
  }

  function isControl(c) { return c in ['personal','business']; }
  function changed(uid,c) {
   let path = /databases/$(database)/documents/finance_v3/$(uid)/controls/$(c);
   return getAfter(path).data.revision == (exists(path) ? get(path).data.revision + 1 : 1);
  }
  function validPot(uid,c,d) {
   return d.keys().hasAll(['name','accountId','reservedCents','targetCents']) && d.keys().hasOnly(['name','accountId','reservedCents','targetCents']) && named(d) && account(uid,c,d.accountId) && get(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(c)/accounts/$(d.accountId)).data.kind != 'investment' && money(d.reservedCents) && money(d.targetCents);
  }
  function validLink(uid,d) {
   return d.keys().hasAll(['fromControl','toControl','fromAccount','toAccount','purpose','description','amountCents','date','dueDate','paidDate','status'])
    && d.keys().hasOnly(['fromControl','toControl','fromAccount','toAccount','purpose','description','amountCents','date','dueDate','paidDate','status'])
    && isControl(d.fromControl) && isControl(d.toControl) && d.fromControl != d.toControl
    && d.purpose in ['prolabore','profit','contribution','reimbursement']
    && (!(d.purpose in ['prolabore','profit']) || d.fromControl == 'business')
    && (d.purpose != 'contribution' || d.fromControl == 'personal')
    && d.description is string && d.description.size() > 0 && d.description.size() <= 200 && money(d.amountCents) && d.amountCents > 0
    && dateString(d.date) && dateString(d.dueDate) && d.status in ['planned','posted','cancelled'] && d.paidDate is string
    && ((d.status == 'posted' && dateString(d.paidDate)) || (d.status != 'posted' && (d.paidDate == '' || dateString(d.paidDate))))
    && account(uid,d.fromControl,d.fromAccount) && account(uid,d.toControl,d.toAccount);
  }

  function validSettlement(uid,c,d) {
   let parent = get(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(c)/transactions/$(d.transactionId)).data;
   let parentAfter = getAfter(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(c)/transactions/$(d.transactionId)).data;
   return d.keys().hasAll(['transactionId','kind','amountCents','date','dueDate','previousDueDate','reason','targetId','operationId','requestKey','sequence'])
    && d.keys().hasOnly(['transactionId','kind','amountCents','date','dueDate','previousDueDate','reason','targetId','operationId','requestKey','sequence'])
    && d.transactionId is string && d.transactionId.size() > 0 && d.transactionId.size() <= 100
    && parentAfter.get('settlementAnchor','') != ''
    && parent.status == 'planned' && parent.kind in ['income','expense','yield']
    && d.kind in ['cash','close','reschedule','reverse'] && money(d.amountCents) && d.amountCents <= parent.amountCents && dateString(d.date)
    && d.reason is string && d.reason.size() <= 200 && d.dueDate is string && d.previousDueDate is string && d.targetId is string
    && d.operationId is string && d.operationId.matches('^[A-Za-z0-9-]{1,100}$') && d.requestKey is string && d.requestKey.size() <= 1500
    && d.sequence is int && d.sequence >= 1 && d.sequence <= 1000000000
    && ((d.kind == 'cash' && d.amountCents > 0 && d.targetId == '' && d.dueDate == '' && d.previousDueDate == '' && d.reason == '')
     || (d.kind == 'close' && d.amountCents > 0 && d.reason.size() > 0 && d.targetId == '' && d.dueDate == '' && d.previousDueDate == '')
     || (d.kind == 'reschedule' && d.amountCents == 0 && d.reason.size() > 0 && dateString(d.dueDate) && dateString(d.previousDueDate) && d.dueDate != d.previousDueDate && d.targetId == '')
     || (d.kind == 'reverse' && d.amountCents == 0 && d.reason.size() > 0 && d.targetId.size() > 0 && d.targetId.size() <= 150 && d.dueDate == '' && d.previousDueDate == ''
      && get(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(c)/settlements/$(d.targetId)).data.transactionId == d.transactionId
      && get(/databases/$(database)/documents/finance_v3/$(uid)/controls/$(c)/settlements/$(d.targetId)).data.kind != 'reverse'));
  }
  match /finance_v3/{uid}/controls/{control} {
   allow read: if owner(uid) && isControl(control);
   allow create, update: if owner(uid) && isControl(control) && request.resource.data.keys().hasOnly(['revision']) && request.resource.data.revision is int && changed(uid,control);
   allow delete: if false;
   match /{kind}/{id} {
    allow read: if owner(uid) && isControl(control) && kind in ['accounts','cards','categories','transactions','budgets','goals','pots','settlements'];
    allow create: if kind == 'settlements' && owner(uid) && isControl(control) && changed(uid,control) && validSettlement(uid,control,request.resource.data);
    allow create, update: if kind != 'settlements' && owner(uid) && isControl(control) && changed(uid,control) &&
     ((kind == 'accounts' && validAccount(request.resource.data)) || (kind == 'cards' && validCard(request.resource.data)) || (kind == 'categories' && request.resource.data.keys().hasOnly(['name']) && named(request.resource.data)) || (kind == 'transactions' && (request.method != 'update' || resource.data.get('settlementAnchor','') == '' || request.resource.data == resource.data) && validTransaction(uid,control,request.resource.data,id)) || (kind == 'budgets' && validBudget(uid,control,request.resource.data)) || (kind == 'goals' && validGoal(request.resource.data)) || (kind == 'pots' && validPot(uid,control,request.resource.data)));
    allow delete: if owner(uid) && isControl(control) && changed(uid,control) && kind in ['accounts','cards','categories','transactions','budgets','goals','pots','settlements'];
   }
  }
  match /finance_v3/{uid}/links/{id} {
   allow read: if owner(uid);
   allow create, update: if owner(uid) && changed(uid,'personal') && changed(uid,'business') && validLink(uid,request.resource.data);
   allow delete: if false;
  }
  // Version 2 test records are intentionally outside the new application.
  // No access is granted to them by this ruleset. Authentication is unchanged.
 }
}
